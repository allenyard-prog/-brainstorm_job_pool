{
  "name": "job-site-automation",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "web:dev": "npm run dev --workspace web",
    "web:build": "npm run build --workspace web",
    "web:test": "npm run test --workspace web",
    "web:e2e": "node --test --test-concurrency=1 --test-timeout=90000 test/web-*.e2e.js",
    "service": "node --env-file-if-exists=.env src/service/server.js",
    "service:init": "node --env-file-if-exists=.env scripts/bootstrap-service.mjs",
    "login": "node --env-file-if-exists=.env src/cli.js login",
    "start": "node --env-file-if-exists=.env src/cli.js start",
    "inspect": "node --env-file-if-exists=.env src/cli.js inspect",
    "compare": "node --env-file-if-exists=.env src/cli.js compare",
    "plugin:create": "node scripts/create-plugin.mjs",
    "export": "node --env-file-if-exists=.env src/cli.js export",
    "test": "node --test --test-concurrency=1 --test-timeout=45000 test/*.test.js",
    "test:service": "node --test --test-concurrency=1 --test-timeout=45000 test/service-*.test.js",
    "browsers:install": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.10",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "fastify": "5.12.8",
    "playwright": "1.65.0"
  }
}
