JOBRIGHT_EMAIL=
JOBRIGHT_PASSWORD=
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
JOB_INTERVAL_MS=2000
EMPTY_POLL_MS=30000
NAVIGATION_TIMEOUT_MS=30000
# Optional: chromium (bundled default), chrome, or msedge
BROWSER_CHANNEL=chromium

# Created by npm run service:init; keep this key stable to decrypt connections.
SERVICE_ENCRYPTION_KEY=
SERVICE_PORT=3000
WORKER_CONCURRENCY=2

# Optional AI layer. Models must also be explicitly allowlisted in config/ai-models.json.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
AI_TIMEOUT_MS=120000
# Optional absolute or workspace-relative model catalog path.
# AI_MODELS_CONFIG=./config/ai-models.json
